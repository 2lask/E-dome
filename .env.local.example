# ─── E-Dome environment ─────────────────────────────────────────
# Renomme ce fichier en .env.local et remplis les valeurs ci-dessous.

# ─── Supabase (auth + DB) ────────────────────────────────────────
# 1. Cree un projet sur https://supabase.com (gratuit)
# 2. Va dans Project Settings → API
# 3. Copie l'URL et la clef "anon public" ci-dessous
# 4. Pour Google OAuth : Authentication → Providers → Google (active + colle
#    client_id et client_secret de Google Cloud Console)
# 5. Dans Google Cloud Console, ajoute comme Authorized redirect URI :
#    https://<ton-projet>.supabase.co/auth/v1/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optionnel : service role key (utilise UNIQUEMENT en server-side, jamais
# expose au client). Necessaire pour les operations admin (creer user
# manuellement, RLS bypass, etc).
SUPABASE_SERVICE_ROLE_KEY=

# ─── IA (assistant Expert E-Dome) ────────────────────────────────────────
# Clef API Anthropic (Claude), utilisee UNIQUEMENT cote serveur (jamais
# exposee au client). Sans elle, l'assistant renvoie un message de repli et
# la demo continue de fonctionner.
ANTHROPIC_API_KEY=
# Optionnel : modele par defaut claude-opus-5. Mettre claude-sonnet-5 ou
# claude-haiku-4-5 pour reduire le cout.
AI_MODEL=claude-opus-5

# ─── Landing page : stockage des manifestations d'interet ────────────────────
# La cle "service_role" (Project Settings -> API) est OBLIGATOIRE pour ecrire
# dans la table `leads`, dont la securite au niveau des lignes est activee
# sans aucune politique. Elle est utilisee UNIQUEMENT cote serveur et ne doit
# jamais etre prefixee NEXT_PUBLIC_.
# Sans elle : repli sur un fichier .leads.local.json en developpement, echec
# explicite en production.
# Schema de la table a executer : supabase/leads.sql
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe unique d'acces a /admin/leads, verifie cote serveur.
# Le changer invalide immediatement toutes les sessions ouvertes.
ADMIN_PASSWORD=

# URL canonique du site. Sert aux metadonnees et aux liens de parrainage.
# Si absente, elle est deduite des en-tetes de la requete — ce qui suffit,
# y compris sur un deploiement de previsualisation Vercel.
NEXT_PUBLIC_BASE_URL=

# Lien de prise de rendez-vous (Cal.com, Calendly...). Le bouton
# correspondant n'apparait sur /merci que si cette variable est renseignee.
NEXT_PUBLIC_BOOKING_URL=

# ─── Mesure d'audience (facultatif) ─────────────────────────────────────────
# Rien n'est charge et aucun cookie n'est depose tant que ces variables sont
# vides. Plausible ne pose pas de cookie.
# ATTENTION : activer PostHog impose une banniere de consentement ET une mise
# a jour de la politique de confidentialite, qui affirme aujourd'hui
# n'utiliser aucun tracage tiers.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
