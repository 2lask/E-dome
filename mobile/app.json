{
  "expo": {
    "name": "E-Dome Démo",
    "slug": "edome-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "primaryColor": "#1e9df1",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "world.edome.demo",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "world.edome.demo",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": []
  }
}
