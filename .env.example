# Modèle des variables d'environnement — AUCUNE valeur réelle ici.
# Copier vers .env.local (ignoré par git) et remplir.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Accès à /admin/traction (e-mails séparés par des virgules)
EDOME_ADMIN_EMAILS=

# E-mails de notification (Resend). Sans ces trois variables, rien n'est envoyé.
RESEND_API_KEY=
EDOME_EMAIL_FROM=
NEXT_PUBLIC_SITE_URL=

# Copilote IA
ANTHROPIC_API_KEY=
